{
  "include": [
    "ai",
    "backend",
    "scripts",
    "tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/venv",
    ".next"
  ],
  "extraPaths": [
    "backend",
    "."
  ],
  "executionEnvironments": [
    {
