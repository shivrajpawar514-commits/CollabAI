{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ CollabAI Platform Health & Real-Time Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "req/sec",
            "axisPlacement": "auto",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(collabai_api_requests_total[1m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "API Request Rate (Throughput RPS)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "latency (ms)",
            "axisPlacement": "auto",
            "fillOpacity": 25,
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(collabai_api_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(collabai_api_latency_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency",
          "refId": "B"
        }
      ],
      "title": "API Gateway Latency (P95 / P99 ms)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 150 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "collabai_active_websocket_connections",
          "legendFormat": "Active Sockets",
          "refId": "A"
        }
      ],
      "title": "Active WebSocket Connections",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "🤖 AI Model Inferences & RAG Pipeline Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(collabai_llm_inference_duration_seconds_sum[5m])) by (provider) / sum(rate(collabai_llm_inference_duration_seconds_count[5m])) by (provider)",
          "legendFormat": "{{provider}} Avg Inference Latency",
          "refId": "A"
        }
      ],
      "title": "LLM Inference Latency by Provider (Gemini / Groq / Ollama)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(collabai_rag_query_total[5m])) by (status)",
          "legendFormat": "RAG Query ({{status}})",
          "refId": "A"
        }
      ],
      "title": "RAG Hybrid Search Queries & Cache Hit Ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "🐙 GitHub Engineering Velocity & PR Cycle Time Telemetry",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 12 },
              { "color": "red", "value": 24 }
            ]
          },
          "unit": "h"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "collabai_github_pr_cycle_time_hours",
          "legendFormat": "Mean PR Cycle Time",
          "refId": "A"
        }
      ],
      "title": "Average Pull Request Cycle Time (Merge Latency)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 17 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(collabai_github_pr_events_total[1h])) by (action)",
          "legendFormat": "PR Action: {{action}}",
          "refId": "A"
        }
      ],
      "title": "PR Merge Velocity & Code Churn Activity",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["collabai", "production", "fastapi", "github", "ai"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "CollabAI Production Overview & PR Cycle Time",
  "version": 1
}
