# -------------------------------------------------------------
# CollabAI Environment Configuration (Free-Tier Stack)
# -------------------------------------------------------------

# PostgreSQL with pgvector (Local Docker, Neon, or Supabase)
# For local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/collabai
# For SQLite (local quick testing without Docker): sqlite+aiosqlite:///./collabai.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/collabai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collabai
POSTGRES_PORT=5432

# Redis Cache & PubSub
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Security & JWT Auth
SECRET_KEY=collabai_super_secret_development_key_change_me_in_prod_9988
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub OAuth (Optional for Phase 1)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# AI & LLM Providers (Free Tier / Swappable)
DEFAULT_LLM_PROVIDER=gemini # 'gemini' | 'groq' | 'ollama'
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Supabase Storage / Cloudflare R2 (for Phase 2 file attachments)
STORAGE_PROVIDER=local # 'local' | 'supabase' | 'r2'
